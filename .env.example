# ═══════════════════════════════════════════════════════
# Video VLM Platform — Variables d'environnement
# Copier en .env et adapter
# ═══════════════════════════════════════════════════════

# ── GPU ──────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=0
CUDA_VISIBLE_DEVICES=0

# ── Mock ─────────────────────────────────────────────────
# 1 = autorise résultats simulés si modèle KO (démo)
# 0 = erreur explicite (évaluation / prod)
ALLOW_MOCK=1

# LocateAnything-3B : son code remote (Parallel Box Decoding) est incompatible
# transformers v5 — il charge mais ne produit aucune boîte exploitable. À 1
# (défaut) son chargement est court-circuité et il sert la simulation.
# Mettre 0 pour retenter l'inférence réelle (ex. worker transformers < 4.50).
LOCATE_ANYTHING_DEGRADED=1

# ── Modèles par défaut ───────────────────────────────────
DEFAULT_VLM=llava-next-video-7b
DEFAULT_CLIP=ViT-L/14
DEFAULT_DETECTOR=grounding_dino_v2
DEFAULT_TRACKER=botsort
DEFAULT_OCR=paddleocr_v4

# ── Limites vidéo ────────────────────────────────────────
MAX_VIDEO_SIZE_MB=2048
MAX_VIDEO_DURATION_SEC=3600

# ── API ───────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
WS_BASE_URL=ws://localhost:8000
# API_KEY=changeme  # décommenter pour activer l'auth

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vlm:vlm@postgres:5432/vlmdb
POSTGRES_USER=vlm
POSTGRES_PASSWORD=vlm
POSTGRES_DB=vlmdb

# ── Qdrant ────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ── MinIO ─────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videos

# ── Chemins ───────────────────────────────────────────────
MODELS_PATH=/models
VIDEO_DIR=/data/videos

# ── MLflow ────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── APIs externes (optionnel) ────────────────────────────
# OPENAI_API_KEY=sk-...     # pour GPT-4o-Vision
# ANTHROPIC_API_KEY=...     # pour Claude Vision
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # HuggingFace token pour les grands modèles

# ── Celery ────────────────────────────────────────────────
CELERY_WORKER_CONCURRENCY=1
CELERY_MAX_TASKS_PER_CHILD=10

# ── Optimisations GPU ────────────────────────────────────
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
CUDA_LAUNCH_BLOCKING=0
TORCH_COMPILE=0   # mettre 1 pour activer torch.compile() (lent au premier run)
